{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-red-survival",
  "main": "worker.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MultiplayerRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MultiplayerRoom"
      ]
    }
  ]
}
